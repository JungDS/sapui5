#!/bin/sh
# .githooks/pre-commit
# 목적: 수정(또는 삭제)되는 html/css/js/mjs 파일의 "직전(HEAD) 버전"을
#       archive/auto/ 아래에 타임스탬프와 함께 자동 보관한다.
# 근거: .project-docs/03_CONVENTIONS.md §4 (Archive 규칙) — 문서 규칙을 git이 강제.
# 경고: 이 보관을 우회하지 말 것. `git commit --no-verify` 사용 금지.
#
# 동작:
#   - 스테이징된 변경 중 Modified(M)·Renamed(R)·Deleted(D) 만 대상.
#   - 신규(Added) 파일은 직전 버전이 없으므로 보관하지 않는다.
#   - archive/ 경로와 대상 외 확장자는 건너뛴다.
#   - 보관본은 같은 커밋에 함께 스테이징된다.

# 초기 커밋(HEAD 없음)이면 보관할 직전 버전이 없으므로 통과
git rev-parse --verify -q HEAD >/dev/null 2>&1 || exit 0

ts=$(date +%Y%m%d-%H%M%S)

git diff --cached --name-only --diff-filter=MRD -M | while IFS= read -r src; do
  # archive/ 자체는 읽기 전용 → 제외
  case "$src" in
    archive/*) continue ;;
  esac

  # 대상 확장자만 (콘텐츠+코드)
  case "$src" in
    *.html|*.css|*.js|*.mjs) ;;
    *) continue ;;
  esac

  prev_dir="archive/auto/$(dirname "$src")"
  base=$(basename "$src")
  name=${base%.*}
  ext=${base##*.}
  dest="$prev_dir/${name}__${ts}.${ext}"

  mkdir -p "$prev_dir" || continue
  # HEAD(직전 커밋) 버전을 보관. 추적 이력이 없으면 건너뛴다.
  if git show "HEAD:$src" > "$dest" 2>/dev/null; then
    git add "$dest"
  else
    rm -f "$dest"
  fi
done

exit 0
