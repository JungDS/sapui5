      "transaction-data": { title: "Transaction Data", definition: "판매오더, 구매오더, 입고문서, 청구문서, 회계전표처럼 실제 업무 이벤트가 발생하면서 생성되는 거래 데이터입니다.", examples: ["마스터 데이터는 기준이고, 트랜잭션 데이터는 실제 발생 기록입니다."] },
      "sales-order": { title: "Sales Order", definition: "고객에게 판매할 품목, 수량, 가격, 납기, 납품 조건 등을 확정하는 판매 문서입니다.", examples: ["후속 문서로 Delivery와 Billing Document가 이어질 수 있습니다."] },
      "delivery": { title: "Delivery", definition: "판매오더 등을 바탕으로 실제 물류 실행을 관리하는 납품 문서입니다. 출고 처리와 연결되며 재고와 원가에 영향을 줄 수 있습니다.", examples: ["Outbound Delivery, Post Goods Issue를 함께 설명하면 이해가 쉽습니다."] },
      "invoice": { title: "Invoice", definition: "대금 청구 또는 송장 문서입니다. 영업에서는 고객 청구문서, 구매에서는 공급업체 송장으로 구분해 설명하는 것이 좋습니다.", examples: ["청구문서가 회계로 전기되면 매출·채권 또는 채무 영향이 발생합니다."] },
      "purchase-order": { title: "Purchase Order", definition: "공급업체에 자재나 서비스를 어떤 조건으로 구매할지 확정하는 구매 문서입니다.", examples: ["구매오더 자체보다 입고와 송장검증 단계에서 회계 영향이 구체화됩니다."] },
      "goods-receipt": { title: "Goods Receipt", definition: "자재나 서비스가 실제로 입고 또는 수령되었음을 기록하는 물류 이벤트입니다.", examples: ["구매오더 이력 갱신, 재고 증가, GR/IR 반영과 연결됩니다."] },
      "grir": { title: "GR/IR", definition: "Goods Receipt / Invoice Receipt의 약자입니다. 입고와 송장이 다른 시점에 발생할 때 두 단계를 연결해 주는 정리 계정 개념입니다.", examples: ["입고는 되었지만 송장이 아직 없는 상태, 송장은 왔지만 입고와 비교해야 하는 상태를 설명할 때 유용합니다."] },
      "posting": { title: "Posting", definition: "업무 이벤트를 회계전표, 자재문서 등 시스템 장부에 확정 반영하는 처리입니다.", examples: ["전기 후에는 보고서와 원장, 재고 수량·가치에 영향을 줄 수 있습니다."] },
      "gl-account": { title: "G/L Account", definition: "총계정원장 계정입니다. 거래가 어떤 회계 계정으로 기록될지 결정하는 기준입니다.", examples: ["매출, 재고, 매출원가, 고객채권, 공급업체채무 같은 계정으로 설명할 수 있습니다."] },
      "cost-center": { title: "Cost Center", definition: "비용이 발생하는 조직 또는 책임 단위입니다. 부서 비용 집계, 예산 관리, 배부의 기준이 됩니다.", examples: ["급여, 활동비, 일반비용을 어느 조직 비용으로 볼 것인지 결정할 때 사용합니다."] },
      "document-flow": { title: "Document Flow", definition: "선행 문서와 후속 문서의 관계를 보여주는 흐름입니다. SAP에서는 판매오더에서 납품, 청구, 회계문서로 이어지는 진행 상태를 이해하는 데 중요합니다.", examples: ["문서 하나만 보는 것이 아니라 전체 체인을 보는 훈련이 필요합니다."] },
      "timesheet": { title: "Time Sheet", definition: "직원 또는 작업자의 근무시간·작업시간을 기록하는 도구입니다. 급여, 프로젝트, 원가 배부와 연결될 수 있습니다.", examples: ["HR 데이터가 원가회계로 넘어가는 대표적인 환승 지점입니다."] },
      "btp": { title: "SAP BTP", definition: "SAP Business Technology Platform입니다. 애플리케이션 개발, 통합, 자동화, 데이터·분석, 확장 기능을 제공하는 SAP의 기술 플랫폼입니다.", examples: ["표준 ERP 코어를 직접 수정하지 않고 외부 확장 앱이나 이벤트 기반 연계를 구성할 때 활용됩니다."] },
      "clean-core": { title: "Clean Core", definition: "표준 핵심 시스템을 가능한 깨끗하게 유지하고, 차별화 요구사항은 공개 확장 방식이나 외부 확장 계층으로 분리하려는 아키텍처 원칙입니다.", examples: ["업그레이드 안정성, 유지보수성, 표준 기능 활용성을 높이는 방향으로 설명할 수 있습니다."] }
    };

    const dialog = document.getElementById("glossaryDialog");
    const dialogTitle = document.getElementById("dialogTitle");
    const dialogDefinition = document.getElementById("dialogDefinition");
    const dialogExamples = document.getElementById("dialogExamples");
    const dialogClose = document.getElementById("dialogClose");

    function openTerm(key) {
      const item = glossary[key];
      if (!item) return;
      dialogTitle.textContent = item.title;
      dialogDefinition.textContent = item.definition;
      dialogExamples.innerHTML = "";
      item.examples.forEach((example) => {
        const li = document.createElement("li");
        li.textContent = example;
        dialogExamples.appendChild(li);
      });
      dialog.showModal();
    }

    document.querySelectorAll("[data-term]").forEach((button) => {
      button.addEventListener("click", () => openTerm(button.dataset.term));
    });

    dialogClose.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      const rect = dialog.getBoundingClientRect();
      const isInside = event.clientX >= rect.left && event.clientX <= rect.right && event.clientY >= rect.top && event.clientY <= rect.bottom;
      if (!isInside) dialog.close();
    });

    const tabButtons = Array.from(document.querySelectorAll(".tab-btn"));
    const tabPanels = Array.from(document.querySelectorAll(".tab-panel"));

    function activateTab(activeButton) {
      tabButtons.forEach((button) => {
        const isSelected = button === activeButton;
        button.setAttribute("aria-selected", String(isSelected));
        button.tabIndex = isSelected ? 0 : -1;
      });
      tabPanels.forEach((panel) => {
        panel.classList.toggle("active", panel.id === activeButton.getAttribute("aria-controls"));
      });
    }

    tabButtons.forEach((button, index) => {
      button.addEventListener("click", () => activateTab(button));
      button.addEventListener("keydown", (event) => {
        const prev = (index - 1 + tabButtons.length) % tabButtons.length;
        const next = (index + 1) % tabButtons.length;
        if (event.key === "ArrowLeft") { tabButtons[prev].focus(); }
        if (event.key === "ArrowRight") { tabButtons[next].focus(); }
        if (event.key === "Home") { tabButtons[0].focus(); }
        if (event.key === "End") { tabButtons[tabButtons.length - 1].focus(); }
        if (event.key === "Enter" || event.key === " ") { event.preventDefault(); activateTab(button); }
      });
    });
  </script>
