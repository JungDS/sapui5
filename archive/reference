<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ERP Business Process Metro - 상세 교육용 가이드</title>
  <meta name="description" content="ERP Business Process Metro 이미지를 기반으로 SAP S/4HANA 관점의 엔드투엔드 업무 프로세스를 설명하는 상세 교육용 HTML 문서" />
  <style>
    :root {
      --bg: #f5f8fc;
      --panel: #ffffff;
      --ink: #172033;
      --muted: #5e6b82;
      --line: #d9e2ef;
      --brand: #0b63ce;
      --brand-dark: #074a9b;
      --finance: #d94b00;
      --hr: #52c41a;
      --proc: #0891b2;
      --sales: #eab308;
      --prod: #6b007b;
      --soft-finance: #fff0e6;
      --soft-hr: #effbea;
      --soft-proc: #e8f9fd;
      --soft-sales: #fff9db;
      --soft-prod: #f8ecff;
      --soft-blue: #eaf3ff;
      --soft-gray: #f8fafc;
      --shadow: 0 18px 45px rgba(15, 23, 42, 0.09);
      --radius: 22px;
      --max: 1360px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: "Pretendard", "Apple SD Gothic Neo", "Noto Sans KR", "Segoe UI", Arial, sans-serif;
      color: var(--ink);
      background:
        radial-gradient(circle at 10% 0%, rgba(11, 99, 206, .11), transparent 34rem),
        radial-gradient(circle at 100% 8%, rgba(82, 196, 26, .08), transparent 30rem),
        linear-gradient(180deg, #fbfdff 0%, var(--bg) 45%, #eef4fb 100%);
      line-height: 1.72;
      word-break: keep-all;
    }

    a { color: var(--brand); text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
    img { display: block; max-width: 100%; }
    code { padding: .12rem .36rem; border-radius: 8px; background: #edf2f7; color: #1f2937; }
    strong { font-weight: 800; }

    .skip-link {
      position: absolute;
      top: -100px;
      left: 1rem;
      z-index: 9999;
      background: #fff;
      color: var(--brand-dark);
      padding: .8rem 1rem;
      border-radius: 12px;
      box-shadow: var(--shadow);
    }
    .skip-link:focus { top: 1rem; }

    .wrap { width: min(100% - 2rem, var(--max)); margin: 0 auto; }

    .hero {
      padding: 3.2rem 0 1.6rem;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(340px, .95fr);
      gap: 1.3rem;
      align-items: stretch;
    }
    .hero-copy, .panel, .image-panel, .card, .deep-card, .table-panel, .callout, .source-box, .route-card, .quiz-item {
      background: rgba(255, 255, 255, .94);
      border: 1px solid rgba(217, 226, 239, .95);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }
    .hero-copy { padding: 2rem; }
    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      padding: .32rem .72rem;
      border: 1px solid #cfe2ff;
      border-radius: 999px;
      background: #eef6ff;
      color: var(--brand-dark);
      font-weight: 800;
      font-size: .92rem;
      margin-bottom: .9rem;
    }
    h1 {
      margin: 0 0 1rem;
      font-size: clamp(2.15rem, 4vw, 4rem);
      line-height: 1.08;
      letter-spacing: -.04em;
    }
    .lead {
      margin: 0;
      font-size: 1.08rem;
      color: #39465e;
    }
    .hero-actions { display: flex; gap: .7rem; flex-wrap: wrap; margin-top: 1.4rem; }
    .btn-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: .7rem 1rem;
      border-radius: 999px;
      border: 1px solid var(--brand);
      background: var(--brand);
      color: #fff;
      font-weight: 800;
      text-decoration: none;
    }
    .btn-link.secondary { background: #fff; color: var(--brand-dark); border-color: #b9d7ff; }

    .summary-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .8rem;
      margin-top: 1.3rem;
    }
    .summary-list div {
      background: var(--soft-gray);
      border: 1px solid #e6edf7;
      border-radius: 16px;
      padding: .88rem;
    }
    .summary-list b { display: block; margin-bottom: .25rem; }
    .summary-list span { color: var(--muted); font-size: .95rem; }

    .image-panel { overflow: hidden; }
    .image-panel figure { margin: 0; }
    .image-panel img { width: 100%; height: auto; background: #fff; }
    .image-panel figcaption {
      padding: .9rem 1.05rem 1.1rem;
      color: var(--muted);
      font-size: .93rem;
      border-top: 1px solid var(--line);
      background: #fff;
    }

    .toc {
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(14px);
      background: rgba(245, 248, 252, .88);
      border-top: 1px solid rgba(217, 226, 239, .7);
      border-bottom: 1px solid rgba(217, 226, 239, .9);
    }
    .toc .wrap {
      display: flex;
      gap: .5rem;
      overflow-x: auto;
      padding: .78rem 1rem;
    }
    .toc a {
      flex: 0 0 auto;
      padding: .48rem .8rem;
      border-radius: 999px;
      color: #2a3952;
      text-decoration: none;
      background: #fff;
      border: 1px solid #e4ebf4;
      font-size: .92rem;
      font-weight: 750;
    }
    .toc a:hover { border-color: #9fc6ff; color: var(--brand-dark); }

    main { padding: 1.6rem 0 3rem; }
    section { scroll-margin-top: 5.5rem; }
    .section-title {
      margin: 3.2rem 0 1rem;
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 1rem;
    }
    .section-title h2 {
      margin: 0;
      font-size: clamp(1.55rem, 2.4vw, 2.35rem);
      line-height: 1.15;
      letter-spacing: -.03em;
    }
    .section-title p {
      max-width: 660px;
      margin: 0;
      color: var(--muted);
      font-size: .98rem;
    }

    .panel { padding: 1.25rem; }
    .callout {
      padding: 1.15rem 1.25rem;
      border-left: 7px solid var(--brand);
      margin: 1rem 0;
    }
    .callout h3 { margin: 0 0 .45rem; font-size: 1.15rem; }
    .callout p { margin: .35rem 0; }
    .callout.warn { border-left-color: #f59e0b; background: #fffbeb; }
    .callout.good { border-left-color: #22c55e; background: #f0fdf4; }

    .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
    .grid-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
    .grid-5 { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; }

    .card { padding: 1.05rem; }
    .card h3 { margin: .1rem 0 .5rem; font-size: 1.12rem; line-height: 1.3; }
    .card p { margin: .45rem 0; }
    .card ul, .card ol { padding-left: 1.25rem; margin: .55rem 0; }
    .tag {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      padding: .22rem .62rem;
      border-radius: 999px;
      border: 1px solid #d8e2ef;
      background: #f8fafc;
      color: #43506a;
      font-size: .86rem;
      font-weight: 800;
      margin-bottom: .55rem;
    }
    .route-dot { width: .8rem; height: .8rem; border-radius: 50%; display: inline-block; }
    .finance { background: var(--finance); }
    .hr { background: var(--hr); }
    .proc { background: var(--proc); }
    .sales { background: var(--sales); }
    .prod { background: var(--prod); }

    .reading-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .reading-rule {
      padding: 1rem;
      border-radius: 18px;
      border: 1px solid #e1e9f4;
      background: #fff;
    }
    .reading-rule b { display: block; margin-bottom: .35rem; }
    .reading-rule span { color: var(--muted); }

    .route-card { overflow: hidden; }
    .route-head {
      padding: 1rem 1.1rem;
      color: #fff;
    }
    .route-head h3 { margin: 0 0 .2rem; font-size: 1.25rem; }
    .route-head p { margin: 0; opacity: .92; }
    .route-body { padding: 1.1rem; }
    .route-body h4 { margin: 1rem 0 .35rem; font-size: 1.03rem; }
    .route-body h4:first-child { margin-top: .1rem; }
    .route-body ul { margin: .35rem 0 .8rem; padding-left: 1.2rem; }
    .route-body li + li { margin-top: .35rem; }

    .route-finance .route-head { background: linear-gradient(135deg, #c2410c, var(--finance)); }
    .route-hr .route-head { background: linear-gradient(135deg, #15803d, var(--hr)); }
    .route-proc .route-head { background: linear-gradient(135deg, #0369a1, var(--proc)); }
    .route-sales .route-head { background: linear-gradient(135deg, #b45309, var(--sales)); color: #27200a; }
    .route-prod .route-head { background: linear-gradient(135deg, #581c87, var(--prod)); }

    .process-flow {
      display: grid;
      grid-template-columns: repeat(5, minmax(120px, 1fr));
      gap: .65rem;
      align-items: stretch;
      margin: .9rem 0;
    }
    .step {
      position: relative;
      padding: .85rem .75rem;
      border: 1px solid #dce6f3;
      border-radius: 16px;
      background: #fff;
      min-height: 94px;
    }
    .step b { display: block; margin-bottom: .25rem; }
    .step span { display: block; color: var(--muted); font-size: .9rem; }
    .step:not(:last-child)::after {
      content: "→";
      position: absolute;
      right: -.58rem;
      top: 50%;
      transform: translateY(-50%);
      color: #7c8ca7;
      font-weight: 900;
      z-index: 2;
    }

    .table-panel { overflow: auto; }
    table { width: 100%; border-collapse: collapse; min-width: 860px; }
    th, td { padding: .82rem .9rem; border-bottom: 1px solid #e5edf7; vertical-align: top; text-align: left; }
    th { background: #f1f6fd; color: #24324b; font-weight: 850; }
    td { background: #fff; }
    tbody tr:hover td { background: #fbfdff; }

    .deep-card {
      padding: 1rem 1.1rem;
      margin-bottom: 1rem;
    }
    .deep-card summary {
      cursor: pointer;
      font-weight: 850;
      font-size: 1.08rem;
      color: #1f2a44;
    }
    .deep-card[open] summary { margin-bottom: .8rem; }

    .tab-shell { margin-top: 1rem; }
    .tab-list { display: flex; flex-wrap: wrap; gap: .55rem; margin-bottom: .8rem; }
    .tab-btn {
      border: 1px solid #cddaea;
      background: #fff;
      color: #22304a;
      border-radius: 999px;
      padding: .72rem 1rem;
      font-weight: 850;
      cursor: pointer;
    }
    .tab-btn[aria-selected="true"] { background: var(--brand); color: #fff; border-color: var(--brand); }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    .mock {
      border: 1px solid #dbe6f3;
      border-radius: 18px;
      overflow: hidden;
      background: #fff;
    }
    .mock-title {
      padding: .75rem 1rem;
      background: #1f2a44;
      color: #fff;
      font-weight: 850;
    }
    .mock-row {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      border-bottom: 1px dashed #d7e2ef;
      padding: .68rem 1rem;
      color: #334155;
    }
    .mock-row:last-child { border-bottom: 0; }
    .mock-row strong { color: #111827; }

    .term-btn {
      display: inline;
      border: 0;
      background: transparent;
      color: var(--brand-dark);
      padding: 0 .04rem;
      margin: 0;
      font: inherit;
      font-weight: 800;
      text-decoration: underline;
      text-decoration-thickness: 1.5px;
      text-underline-offset: 3px;
      cursor: pointer;
    }
    .term-cloud { display: flex; flex-wrap: wrap; gap: .5rem; }
    .term-chip {
      border: 1px solid #cfe0f6;
      background: #fff;
      color: var(--brand-dark);
      padding: .55rem .78rem;
      border-radius: 999px;
      cursor: pointer;
      font-weight: 850;
    }

    .quiz-item { padding: 1rem 1.1rem; }
    .quiz-item summary { cursor: pointer; font-weight: 850; }
    .quiz-item + .quiz-item { margin-top: .8rem; }

    .source-box { padding: 1.2rem; }
    .source-box ul { margin: .4rem 0; padding-left: 1.25rem; }
    .source-box li + li { margin-top: .35rem; }

    dialog {
      width: min(760px, calc(100% - 2rem));
      border: 0;
      border-radius: 24px;
      padding: 0;
      box-shadow: 0 26px 75px rgba(15, 23, 42, .32);
      color: var(--ink);
    }
    dialog::backdrop { background: rgba(15, 23, 42, .54); backdrop-filter: blur(2px); }
    .dialog-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1.2rem;
      border-bottom: 1px solid #e4ebf5;
      background: #f8fbff;
    }
    .dialog-head h2 { margin: 0; font-size: 1.28rem; }
    .dialog-close {
      width: 42px;
      height: 42px;
      border: 0;
      border-radius: 12px;
      background: #e6eef9;
      font-size: 1.35rem;
      cursor: pointer;
    }
    .dialog-body { padding: 1.05rem 1.2rem 1.25rem; }
    .dialog-body p { margin-top: 0; }
    .dialog-body ul { padding-left: 1.2rem; }

    footer {
      padding: 2rem 0 3rem;
      color: var(--muted);
      text-align: center;
      border-top: 1px solid #dce6f3;
      background: rgba(255, 255, 255, .65);
    }
    footer p { margin: .25rem 0; }

    @media (max-width: 1180px) {
      .hero-grid, .reading-grid, .grid-2 { grid-template-columns: 1fr; }
      .grid-5 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .process-flow { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .step:not(:last-child)::after { display: none; }
    }
    @media (max-width: 700px) {
      .hero { padding-top: 2rem; }
      .hero-copy { padding: 1.25rem; }
      .summary-list, .grid-5, .grid-4, .grid-3, .process-flow { grid-template-columns: 1fr; }
      .section-title { display: block; }
      .section-title p { margin-top: .5rem; }
      .toc .wrap { padding-inline: .5rem; }
    }
  </style>
</head>
